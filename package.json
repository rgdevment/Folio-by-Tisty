  "scripts": {
    "prepare": "git config --get core.hooksPath || git config core.hooksPath hooks || echo the hooks are not set: this is not a git clone",
    "limits": "bash scripts/limits-fetch.sh",
    "test": "vitest run",
    "typecheck": "tsc && tsc -p tsconfig.page.json",
    "dev": "vite",
    "build": "vite build && vite build --config vite.admin.config.ts",
    "budget": "node scripts/budget.mjs",
    "words": "node scripts/page-words.ts",
    "lint": "biome check .",
    "format": "biome check . --write",
    "lint:md": "markdownlint-cli2",
    "format:md": "markdownlint-cli2 --fix"
  }
}
